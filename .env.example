# Copy to .env, then fill in the four secrets below. Only SECRET_KEY_BASE is
# required to start; the rest is optional.
#
# Generate all four at once, appending them to this file once it is .env:
#
#   {
#     echo "SECRET_KEY_BASE=$(openssl rand -hex 64)"
#     echo "AR_ENCRYPTION_PRIMARY_KEY=$(openssl rand -hex 32)"
#     echo "AR_ENCRYPTION_DETERMINISTIC_KEY=$(openssl rand -hex 32)"
#     echo "AR_ENCRYPTION_KEY_DERIVATION_SALT=$(openssl rand -hex 32)"
#   } >> .env
#
# Then delete the four empty assignments below, or the empty ones win.

# --- Required --------------------------------------------------------------

# The address members reach this Kith at — no scheme, no path. Every link in an
# email is built from it, and it is the only Host header the app answers to, so
# there is nothing sensible to default it to: Kith refuses to start without it.
KITH_HOST=kith.example.com

# Signs every cookie, and the setup code is derived from it. Change it and
# every session ends and the setup code changes.
#
#   openssl rand -hex 64
SECRET_KEY_BASE=

# --- Active Record encryption ----------------------------------------------
#
# One command each:
#
#   openssl rand -hex 32
#
# Exactly one column in Kith is encrypted — LocalActor#private_key — and
# nothing writes it yet: it is the seam left for federation, which does not
# exist. Rails boots fine with these empty, so they are optional; setting them
# now is one fewer thing to do when it does.
#
# Once something is encrypted, these are unlosable — no amount of
# SECRET_KEY_BASE brings an encrypted column back without them.
AR_ENCRYPTION_PRIMARY_KEY=
AR_ENCRYPTION_DETERMINISTIC_KEY=
AR_ENCRYPTION_KEY_DERIVATION_SALT=

# --- Optional --------------------------------------------------------------

# Which interface to publish on. Default is loopback: put a TLS proxy in front.
HOST_IP=127.0.0.1

RAILS_MAX_THREADS=5
RAILS_LOG_LEVEL=info

# Error reporting. Unset means none at all. Create a project on your Splat and
# press "Copy External DSN".
SENTRY_DSN=
# SENTRY_DSN=https://<public-key>@splat.apps.aapamilne.com/<project-id>
SENTRY_TRACES_SAMPLE_RATE=

# --- Outgoing mail ---------------------------------------------------------
#
# Kith sends exactly one email: the password reset. Leave these unset and that
# is the only thing that does not work — an invite is a link you hand over
# yourself, and nothing else in Kith is delivered by mail.
#
# SMTP_ADDRESS=smtp.example.com
# SMTP_PORT=587
# SMTP_USER_NAME=
# SMTP_PASSWORD=

# Who the reset appears to come from. Defaults to kith@$KITH_HOST, which is
# right unless the relay insists on a mailbox it hosts itself.
# KITH_MAIL_FROM=
