<% content_for :title, "Invites" %>

<div class="flex items-baseline justify-between">
  <h1 class="font-serif text-2xl font-semibold">Invites</h1>
  <%= button_to "Create an invite", invites_path, class: "btn" %>
</div>

<p class="mt-2 max-w-prose text-sm text-quiet">
  Each link works once and expires after <%= pluralize Invite::LIFETIME.in_days.to_i, "day" %>.
  Whoever uses it will show up as invited by you.
</p>

<% if @invites.any? %>
  <ul class="mt-8 divide-y divide-rule border-t border-rule">
    <%= render @invites %>
  </ul>
<% else %>
  <p class="mt-8 border-t border-rule pt-8 text-sm text-quiet">You haven't invited anyone yet.</p>
<% end %>
