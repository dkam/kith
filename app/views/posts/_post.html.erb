<%# A post as it appears in a list: the feed, or someone's profile. %>
<article class="py-8" id="<%= dom_id post %>">
  <%= render "posts/byline", post: post %>

  <% if post.title.present? %>
    <h2 class="post-title mt-3">
      <%= link_to post.title, post, class: "no-underline hover:text-accent" %>
    </h2>
  <% end %>

  <% if post.body? %>
    <div class="mt-3"><%= post.body %></div>
  <% end %>

  <%= render "comments/summary", post: post %>
</article>
