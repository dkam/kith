<%= form_with model: post, class: "mt-8 space-y-6" do |form| %>
  <% if post.errors.any? %>
    <div class="alert">
      <ul class="list-disc space-y-1 pl-4">
        <% post.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, "Title", class: "label" %>
    <%= form.text_field :title, autocomplete: "off", placeholder: "Optional", class: "field field-serif" %>
  </div>

  <div>
    <%= form.label :body, "Words", class: "label" %>
    <%# The editor is Lexxy, which takes over Action Text's helper.
        Three deliberate departures from its defaults:

        value           the body as HTML rather than as the record, so photos
                        already on the post come back as media URLs rather than
                        the blob URLs they were uploaded to. See
                        MediaHelper#editable_body_html.
        blob_url_template
                        where a photo that has *just* been uploaded is previewed
                        from. Lexxy points this at Active Storage's own blob
                        URL, which anyone holding it can fetch forever. See
                        MediaController#pending.
        attachments     photographs only, and only the four types Kith knows how
                        to strip and resize. application.js drops the toolbar's
                        general file button to match. %>
    <%= form.rich_text_area :body,
          value: editable_body_html(post),
          placeholder: "Write something", rows: 12,
          "permitted-attachment-types": "image/jpeg image/png image/webp image/heic",
          data: { blob_url_template: pending_media_path(":signed_id", ":filename") } %>
    <p class="hint">Drop photos in as you write, or paste them. Location and camera data are removed.</p>
  </div>

  <% if post.new_record? %>
    <fieldset class="border-t border-rule pt-6">
      <legend class="label">Who is this for</legend>
      <div class="space-y-3">
        <label class="choice">
          <%= form.radio_button :audience, :followers, checked: true, class: "radio" %>
          <span>
            <span class="choice-label">People who follow me</span>
            <span class="choice-note">The people you've accepted. They can comment.</span>
          </span>
        </label>
        <label class="choice">
          <%= form.radio_button :audience, :public, class: "radio" %>
          <span>
            <span class="choice-label">Anyone with the link</span>
            <span class="choice-note">Anyone on the internet, and other servers can keep copies.</span>
          </span>
        </label>
      </div>
      <p class="hint">You're choosing this once. It can't be changed after you post.</p>
    </fieldset>
  <% else %>
    <p class="border-t border-rule pt-6 text-sm text-quiet">
      This post is
      <span class="font-medium text-ink"><%= post.audience_public? ? "readable by anyone with the link" : "for people who follow you" %></span>.
      That was fixed when you wrote it and can't be changed.
    </p>
  <% end %>

  <div class="flex items-center gap-5">
    <%= form.submit post.new_record? ? "Post" : "Save", class: "btn" %>
    <%= link_to "Cancel", post.persisted? ? post_path(post) : root_path, class: "btn-plain" %>
  </div>
<% end %>
