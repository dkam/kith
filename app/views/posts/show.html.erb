<% content_for :title, @post.excerpt(length: 60) %>

<article>
  <% if @post.draft? %>
    <p class="notice">
      <span class="font-medium text-title">This is a draft.</span>
      Only you can see it. Posting it hands it to
      <%= @post.audience_public? ? "anyone with the link" : "the people who follow you" %>.
    </p>
  <% end %>

  <%= render "posts/byline", post: @post %>

  <% if @post.title.present? %>
    <h1 class="mt-4 font-serif text-3xl font-semibold leading-tight"><%= @post.title %></h1>
  <% end %>

  <% if @post.body? %>
    <div class="mt-4"><%= @post.body %></div>
  <% end %>

  <%# A moderator is offered Delete without Edit: taking words down is a power, %>
  <%# rewriting someone else's is not. Both answers come from Authority. %>
  <% if authority.delete_post?(@post) %>
    <div class="mt-8 flex items-center gap-5 border-t border-rule pt-5">
      <% if authority.edit_post?(@post) %>
        <%= button_to "Post it", publish_post_path(@post), class: "btn btn-sm" if @post.draft? %>
        <%= link_to "Edit", edit_post_path(@post), class: "btn-plain" %>
      <% end %>
      <%= button_to(authority.edit_post?(@post) ? "Delete" : "Remove", @post, method: :delete, class: "btn-plain",
            form: { data: { turbo_confirm: "Delete this post and its photos? This can't be undone." } }) %>
    </div>
  <% end %>
</article>

<%# A draft has no audience yet, so there is nobody to be replying to. %>
<%= render "comments/section", post: @post, comments: @comments, comment: @comment unless @post.draft? %>
