<div class="flex items-center gap-2.5 text-sm">
  <%= avatar_tag post.actor, css_class: "size-7 rounded-full object-cover bg-rule" %>
  <%= render "shared/actor_name", actor: post.actor %>
  <span class="text-hush">·</span>
  <%= link_to post, class: "text-quiet no-underline hover:text-ink" do %>
    <time datetime="<%= post.published_at.iso8601 %>" title="<%= post.published_at.to_fs(:long) %>">
      <%= time_ago_in_words post.published_at %> ago
    </time>
  <% end %>
  <% if post.audience_public? %>
    <span class="rounded-full border border-rule px-1.5 py-0.5 text-[0.6875rem] uppercase tracking-wide text-quiet">Public</span>
  <% end %>
</div>
