<%# Everything both layouts need. The phone apps get this and nothing else;
    what makes Kith installable in a browser is in layouts/_pwa. %>
<title><%= content_for(:title) ? "#{content_for(:title)} · Kith" : "Kith" %></title>
<%# viewport-fit=cover lets the page paint under the notch and the home
    indicator once it is installed; the safe areas are paid back as padding
    in the masthead and the main column, not avoided here. %>
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="application-name" content="Kith">
<meta name="apple-mobile-web-app-title" content="Kith">
<meta name="mobile-web-app-capable" content="yes">
<%# The status bar is drawn by the OS from this colour, so it tracks the two
    grounds rather than sitting between them. %>
<meta name="theme-color" content="#faf9f6" media="(prefers-color-scheme: light)">
<meta name="theme-color" content="#171614" media="(prefers-color-scheme: dark)">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<%# Private by default: a post or a photo reaches a search index only from a
    page that asked to be indexed, which needs a signed-out visitor and an
    author who chose the web. See ApplicationController#allow_indexing_by. %>
<meta name="robots" content="<%= indexable? ? "index, follow" : "noindex, nofollow" %>">
<%= csrf_meta_tags %>
<%= csp_meta_tag %>

<%# `content_for`, not `yield :head`. The yield form only works inside a
    layout; in a partial it returns nothing and says nothing about it, which
    would quietly switch off every Turbo Drive head helper in the app. %>
<%= content_for(:head) %>

<%# Literata reads what a member wrote; Barlow does everything they operated.
    Both are served from app/assets/fonts — see the faces in the stylesheet.
    The two latin romans are preloaded because they set the first screen;
    the italic and the ext subsets can arrive when they are needed. %>
<link rel="preload" href="<%= asset_path("literata-var-latin.woff2") %>" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="<%= asset_path("barlow-400-latin.woff2") %>" as="font" type="font/woff2" crossorigin>

<%= stylesheet_link_tag "lexxy", "data-turbo-track": "reload" %>
<%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
<%= javascript_importmap_tags %>
