<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) ? "#{content_for(:title)} · Kith" : "Kith" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Kith">
    <meta name="mobile-web-app-capable" content="yes">
    <%# Private by default: a post or a photo reaches a search index only from a
        page that asked to be indexed, which needs a signed-out visitor and an
        author who chose the web. See ApplicationController#allow_indexing_by. %>
    <meta name="robots" content="<%= indexable? ? "index, follow" : "noindex, nofollow" %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Literata reads what a member wrote; Barlow does everything they operated.
        Both are served from app/assets/fonts — see the faces in the stylesheet.
        The two latin romans are preloaded because they set the first screen;
        the italic and the ext subsets can arrive when they are needed. %>
    <link rel="preload" href="<%= asset_path("literata-var-latin.woff2") %>" as="font" type="font/woff2" crossorigin>
    <link rel="preload" href="<%= asset_path("barlow-400-latin.woff2") %>" as="font" type="font/woff2" crossorigin>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag "lexxy", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-paper text-ink antialiased">
    <%= render "shared/masthead" if authenticated? %>

    <main class="mx-auto w-full max-w-2xl px-5 py-10">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>
  </body>
</html>
