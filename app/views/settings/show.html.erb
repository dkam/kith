<% content_for :title, "You" %>

<h1 class="font-serif text-2xl font-semibold">You</h1>
<p class="mt-2 text-sm text-quiet">
  You are <span class="font-medium text-ink">@<%= @actor.handle %></span>.
  Handles don't change — other people's links to you depend on it.
</p>

<%# scope: the record is a LocalActor, but the form speaks of actors. %>
<%= form_with model: @actor, scope: :actor, url: settings_path, method: :patch, class: "mt-8 space-y-8" do |form| %>
  <% if @actor.errors.any? %>
    <div class="alert">
      <ul class="list-disc space-y-1 pl-4">
        <% @actor.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :display_name, "Name", class: "label" %>
    <%= form.text_field :display_name, autocomplete: "name", class: "field" %>
    <p class="hint">What your friends call you.</p>
  </div>

  <div>
    <span class="label">Photo</span>
    <div class="flex items-center gap-4">
      <%= avatar_tag @actor, css_class: "avatar size-16" %>
      <%= form.file_field :avatar, accept: "image/jpeg,image/png,image/webp", direct_upload: true, class: "text-sm text-quiet file:mr-3 file:rounded-sm file:border file:border-rule-strong file:bg-surface file:px-3 file:py-1.5 file:text-sm file:text-ink" %>
    </div>
    <p class="hint">Location and camera data are removed from anything you upload.</p>
  </div>

  <fieldset>
    <legend class="label">Who can find you</legend>
    <div class="space-y-3">
      <% {
        everyone: [ "Everyone here", "Anyone signed in can open your profile from your name." ],
        connections_only: [ "People I'm connected with", "People you're connected to can find you. To everyone else your name isn't a link and your posts aren't listed." ],
        invisible: [ "Nobody", "Your profile and your comments are for your connections only." ]
      }.each do |value, (label, description)| %>
        <label class="choice">
          <%= form.radio_button :discoverable, value, class: "radio" %>
          <span>
            <span class="choice-label"><%= label %></span>
            <span class="choice-note"><%= description %></span>
          </span>
        </label>
      <% end %>
    </div>
  </fieldset>

  <div class="flex items-center gap-5 border-t border-rule pt-6">
    <%= form.submit "Save", class: "btn" %>
    <%= link_to "Change your password", new_password_path, class: "btn-plain" %>
  </div>
<% end %>

<%# The endpoints assistants connect to. Everything behind them goes through
    Visibility, the same as the feed — a read-only endpoint can see exactly
    what its member can see, and one that writes publishes under their name. %>
<section class="mt-12 border-t border-rule pt-8">
  <h2 class="font-serif text-xl font-semibold">Endpoints for assistants</h2>
  <p class="mt-2 max-w-prose text-sm text-quiet">
    An endpoint lets an assistant that speaks MCP read your feed, open a post
    you can see, and list your notifications. One that can write also posts and
    comments under your name, to the people who follow you. Nothing an endpoint
    can reach is anything you couldn't reach yourself.
  </p>
  <p class="mt-2 max-w-prose text-sm text-quiet">
    Anyone holding the link can use it, so keep each one the way you'd keep a
    password. Make a separate endpoint for each thing you connect, and revoke
    the one you don't recognise.
  </p>

  <% if @mcp_tokens.any? %>
    <ul class="mt-6 divide-y divide-rule border-y border-rule">
      <%= render @mcp_tokens %>
    </ul>
  <% else %>
    <p class="mt-6 border-t border-rule pt-6 text-sm text-quiet">
      You haven't made one yet.
    </p>
  <% end %>

  <%= form_with model: @new_mcp_token, scope: :mcp_token, url: settings_mcp_tokens_path, class: "mt-8 space-y-5" do |form| %>
    <div>
      <%= form.label :name, "Name a new endpoint", class: "label" %>
      <%= form.text_field :name, required: true, maxlength: McpToken::NAME_LIMIT,
            placeholder: "Claude on my phone", class: "field" %>
      <p class="hint">So you know which is which when you come to revoke one.</p>
    </div>

    <fieldset>
      <legend class="label">What it may do</legend>
      <div class="space-y-3">
        <label class="choice">
          <%= form.radio_button :access, :read_only, checked: true, class: "radio" %>
          <span>
            <span class="choice-label">Read only</span>
            <span class="choice-note">Your feed, posts you can already see, and your notifications. It can't write anything.</span>
          </span>
        </label>
        <label class="choice">
          <%= form.radio_button :access, :read_write, class: "radio" %>
          <span>
            <span class="choice-label">Read and write</span>
            <span class="choice-note">All of that, and it can write posts and comments as you. A post it writes reaches your followers, and its audience can never be changed afterwards.</span>
          </span>
        </label>
      </div>
      <p class="hint">Fixed when you make it. To change it, revoke this one and make another.</p>
    </fieldset>

    <%= form.submit "Make an endpoint", class: "btn-quiet" %>
  <% end %>
</section>
