<section class="mt-10">
  <h2 class="font-serif text-lg font-semibold"><%= title %></h2>

  <% if follows.any? %>
    <ul class="mt-2 divide-y divide-rule border-t border-rule">
      <% follows.each do |follow| %>
        <% actor = follow.public_send(actor_method) %>
        <li class="flex items-center gap-3 py-4">
          <%= avatar_tag actor, css_class: "avatar size-9 shrink-0" %>
          <div class="min-w-0 flex-1">
            <p class="text-sm"><%= render "shared/actor_name", actor: actor %></p>
            <p class="hint">@<%= actor.full_handle %></p>
          </div>
          <div class="shrink-0">
            <%= render "follows/button", actor: actor, follow: current_actor.follow_of(actor) %>
          </div>
        </li>
      <% end %>
    </ul>
  <% else %>
    <p class="mt-2 border-t border-rule pt-4 text-sm text-quiet"><%= empty %></p>
  <% end %>
</section>
