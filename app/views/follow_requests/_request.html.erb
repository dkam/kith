<li class="flex items-center gap-3 py-4" id="<%= dom_id request, :request %>">
  <%= avatar_tag request.follower_actor, css_class: "avatar size-9 shrink-0" %>

  <div class="min-w-0 flex-1">
    <p class="text-sm"><%= render "shared/actor_name", actor: request.follower_actor %> asked to follow you.</p>
    <p class="hint"><%= time_ago_in_words request.created_at %> ago</p>
  </div>

  <div class="flex shrink-0 items-center gap-2">
    <%= button_to "Accept", accept_follow_path(request), class: "btn" %>
    <%= button_to "No", reject_follow_path(request), class: "btn-quiet" %>
  </div>
</li>
