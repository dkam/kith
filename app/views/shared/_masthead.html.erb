<header class="border-b border-rule pt-safe">
  <nav class="mx-auto flex max-w-2xl items-baseline gap-5 px-5 py-4 font-sans text-sm">
    <%# No mark was ever drawn for Kith. Wherever one would go, the word is set
        in Literata 600. %>
    <%= link_to "Kith", root_path, class: "font-serif text-lg font-semibold tracking-[-0.01em] text-title no-underline hover:text-accent" %>

    <div class="ml-auto flex items-baseline gap-5 text-quiet">
      <%= link_to "Write", new_post_path, class: "hover:text-ink" %>
      <%= link_to "Following", follows_path, class: "hover:text-ink" %>
      <%= link_to notifications_path, class: "hover:text-ink" do %>
        Notifications<%= render "shared/unread_badge" %>
      <% end %>
      <%= link_to "Invites", invites_path, class: "hover:text-ink" %>
      <%= link_to "You", settings_path, class: "hover:text-ink" %>
      <%= button_to "Sign out", session_path, method: :delete, class: "btn-plain" %>
    </div>
  </nav>
</header>
