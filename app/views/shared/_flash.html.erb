<%# One hue, so an alert speaks in the accent rather than introducing a red
    that would dilute what terracotta means everywhere else. %>
<% if alert = flash[:alert] %>
  <p id="alert" class="alert"><%= alert %></p>
<% end %>

<% if notice = flash[:notice] %>
  <p id="notice" class="notice"><%= notice %></p>
<% end %>
