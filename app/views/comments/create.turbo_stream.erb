<% if @comment.persisted? %>
  <%= turbo_stream.append dom_id(@post, :comments) do %>
    <%= render "comments/comment", comment: @comment %>
  <% end %>

  <%# A fresh, empty form: the reply has landed, so the box should be ready for
      the next thought rather than still holding the last one. %>
  <%= turbo_stream.replace dom_id(@post, :comment_form) do %>
    <%= render "comments/form", post: @post, comment: Comment.new(post: @post) %>
  <% end %>
<% else %>
  <%= turbo_stream.replace dom_id(@post, :comment_form) do %>
    <%= render "comments/form", post: @post, comment: @comment %>
  <% end %>
<% end %>
