<% content_for :title, "Reset password" %>

<div class="mx-auto max-w-sm">
  <h1 class="font-serif text-2xl font-semibold">Reset your password</h1>
  <p class="mt-2 text-sm text-quiet">We'll email you a link. It's good for fifteen minutes.</p>

  <%= form_with url: passwords_path, class: "mt-8 space-y-5" do |form| %>
    <div>
      <%= form.label :email_address, "Email", class: "label" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", class: "field" %>
    </div>

    <div class="flex items-center gap-5 pt-1">
      <%= form.submit "Email me a link", class: "btn" %>
      <%= link_to "Back to sign in", new_session_path, class: "btn-plain" %>
    </div>
  <% end %>
</div>
