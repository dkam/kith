<% content_for :title, "Sign in" %>

<div class="mx-auto max-w-sm">
  <h1 class="font-serif text-3xl font-semibold">Kith</h1>
  <p class="mt-2 text-sm text-quiet">A quiet place for a few dozen friends. Invite only.</p>

  <% if Setup.open? %>
    <p class="mt-4 text-sm text-quiet">
      Nobody has joined yet.
      <%= link_to "Set up Kith", setup_path, class: "text-accent" %>
      with the code on the server's console.
    </p>
  <% end %>

  <%= form_with url: session_path, class: "mt-8 space-y-5" do |form| %>
    <div>
      <%= form.label :email_address, "Email", class: "label" %>
      <%= form.email_field :email_address, required: true, autofocus: true, autocomplete: "username", value: params[:email_address], class: "field" %>
    </div>

    <div>
      <%= form.label :password, "Password", class: "label" %>
      <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: "field" %>
    </div>

    <div class="flex items-center gap-5 pt-1">
      <%= form.submit "Sign in", class: "btn" %>
      <%= link_to "Forgot password?", new_password_path, class: "btn-plain" %>
    </div>
  <% end %>
</div>
